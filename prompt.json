[
  {
    "role": "user",
    "parts": [
      {
        "text": {{ system_message | dump }}
      }
    ]
  },

  {% for completion in _conversation %}
  {
    "role": "user",
    "parts": [
      {
        "text": {{ completion.input | dump }}
      }
    ]
  },
  {
    "role": "model",
    "parts": [
      {
        "text": {{ completion.output | dump }}
      }
    ]
  },
  {% endfor %}

  {
    "role": "user",
    "parts": [
      {
        "text": {{ message | dump }}
      }
    ]
  }
]
